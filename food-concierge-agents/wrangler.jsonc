{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "food-concierge-agents",
	"main": "worker/index.ts",
	"compatibility_date": "2026-05-14",
	"assets": {
		"not_found_handling": "single-page-application"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": ["nodejs_compat"],
	"ai": {
		"binding": "AI"
	},
	"durable_objects": {
		"bindings": [
			{
				"class_name": "FoodConciergeAgent",
				"name": "FoodConciergeAgent"
			}
		]
	},
	"migrations": [
		{
			"new_sqlite_classes": ["FoodConciergeAgent"],
			"tag": "1"
		}
	]
}
